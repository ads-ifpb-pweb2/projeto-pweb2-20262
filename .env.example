# Copie para .env antes de rodar: cp .env.example .env
# Valores apenas para desenvolvimento local.

# Credenciais do armazenamento de fotos (RustFS, compatível com S3)
S3_ACCESS_KEY=marketplace
S3_SECRET_KEY=marketplace123

JWT_SECRET=troque-este-segredo-de-desenvolvimento-por-um-valor-longo
JWT_EXPIRACAO_HORAS=24

# Chaves VAPID para Push Notification. O professor fornece o par usado por todas as equipes.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:professor@ifpb.edu.br
