    {
      "name": "Autenticação",
      "description": "Cadastro e login de estudantes. Públicos, sem token.",
      "item": [
        {
          "name": "Cadastro",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 201\", () => pm.response.to.have.status(201));",
                  "const corpo = pm.response.json();",
                  "pm.collectionVariables.set(\"outroToken\", corpo.token);",
                  "pm.collectionVariables.set(\"outroUsuarioId\", corpo.usuario.id);"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"emailCadastro\", `estudante.${Date.now()}@academico.ifpb.edu.br`);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/cadastro",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "cadastro"
              ]
            },
            "description": "Cadastra um estudante e devolve a sessão. O e-mail é gerado a cada execução para não repetir. Guarda o token e o id do estudante em `outroToken` e `outroUsuarioId`.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Estudante de Teste\",\n  \"email\": \"{{emailCadastro}}\",\n  \"senha\": \"senha123\",\n  \"cursoId\": 1,\n  \"telefone\": \"(83) 99999-1234\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "const corpo = pm.response.json();",
                  "pm.collectionVariables.set(\"token\", corpo.token);",
                  "pm.collectionVariables.set(\"usuarioId\", corpo.usuario.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Login do estudante de exemplo, da carga. Guarda o token e o id do usuário nas variáveis da coleção.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"estudante@academico.ifpb.edu.br\",\n  \"senha\": \"senha123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
