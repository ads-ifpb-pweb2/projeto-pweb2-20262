      "value": ""
    },
    {
      "key": "outroToken",
      "value": ""
    },
    {
      "key": "outroUsuarioId",
      "value": ""
    },
    {
      "key": "anuncioId",
      "value": ""
    },
    {
      "key": "fotoId",
      "value": ""
    },
    {
      "key": "doacaoId",
      "value": ""
    }
  ],
